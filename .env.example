DATABASE_URL=postgres://mleko:mleko@localhost:5432/mleko
# Admins, comma-separated. Always on the whitelist; everyone else is added in the admin dashboard (/admin/).
ADMIN_EMAILS=you@gmail.com
# OAuth client IDs of the mobile apps (iOS, Android) whose Google ID tokens are accepted.
GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com
# OAuth client ID of type "Web application" for the dashboard's Google sign-in button.
GOOGLE_WEB_CLIENT_ID=
# openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Where photo files are stored.
PHOTO_DIR=./data/photos
# Sign in without Google via POST /auth/dev (ignored when NODE_ENV=production).
DEV_LOGIN=true
# Push notifications (APNs): the .p8 key's contents (line breaks may be written as \n), its key id, the team id,
# and the bundle ids the apps register with. Empty: push is off (devices are still registered).
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_APP_IDS=pl.dobremleko.app,pl.dobremleko.app.dev
# Android (FCM): the Firebase service account's JSON key file contents (one line). Empty: Android is not sent to.
FCM_SERVICE_ACCOUNT=
# PMO, the issue tracker behind /reports (bug reports, ideas, abuse): its URL and this app's key (pmo_a_…).
# Empty: GET/POST /reports answer 503.
PMO_API_URL=
PMO_API_KEY=
PMO_PROJECT=DM
